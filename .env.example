# Documentation: https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview

APP_UID=
APP_GID=

# POSTGRES_VERSION='18-alpine'
# VW_VERSION='latest'

# HOST_BIND_IP='127.0.0.1'
# HOST_PORT='55080'

IP_HEADER=X-Forwarded-For
IP_HEADER_TRUSTED_PROXIES='172.20.0.254,172.20.0.1,127.0.0.1'

LOG_LEVEL=warn
EXTENDED_LOGGING=true
LOG_TIMESTAMP_FORMAT="%Y-%m-%d %H:%M:%S.%3f%z"

SIGNUPS_ALLOWED=false
SHOW_PASSWORD_HINT=false
PASSWORD_ITERATIONS=600000
PASSWORD_HINTS_ALLOWED=true

LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_SESSION_LIFETIME=20
DISABLE_ADMIN_TOKEN=false

# WEB_VAULT_ENABLED=false
# SENDS_ALLOWED=false
# EMERGENCY_ACCESS_ALLOWED=false
# EMAIL_CHANGE_ALLOWED=false

# SIGNUPS_VERIFY=true
# SIGNUPS_VERIFY_RESEND_TIME=3600
# SIGNUPS_VERIFY_RESEND_LIMIT=3

# INVITATIONS_ALLOWED=false
# INVITATION_ORG_NAME=Vaultwarden
# INVITATION_EXPIRATION_HOURS=120

# DISABLE_ICON_DOWNLOAD=true

# AUTHENTICATOR_DISABLE_TIME_DRIFT=true

# USER_ATTACHMENT_LIMIT=1048576
# ORG_ATTACHMENT_LIMIT=10485760
# USER_SEND_LIMIT=20

# TRASH_AUTO_DELETE_DAYS=7
# INCOMPLETE_2FA_TIME_LIMIT=3
# EVENTS_DAYS_RETAIN=3

# ALLOWED_IFRAME_ANCESTORS=
# ALLOWED_CONNECT_SRC=""

# EMAIL_TOKEN_SIZE=6
# EMAIL_EXPIRATION_TIME=600
# EMAIL_ATTEMPTS_LIMIT=3

# SMTP_SECURITY=force_tls
